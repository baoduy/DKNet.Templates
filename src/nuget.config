<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Pin restore to nuget.org only. All DKNet.* packages are published there,
         so the github/baoduy feed isn't needed here. Keeps restores deterministic
         across contributors and resolves NU1507 under central package management. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>