<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>default</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- This is required for DKNet.EfCore.DtoGenerator to emit generated files -->
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
        <!-- Force analyzer to reload on every build to avoid caching issues -->
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <!-- Custom target to copy generated DTOs to project/GeneratedDtos folder, flattening structure and preserving names/extensions -->
<!--    <Target Name="CopyGeneratedDtosToOutputFolder" AfterTargets="CoreCompile" Condition="Exists('$(CompilerGeneratedFilesOutputPath)')">-->
<!--        <ItemGroup>-->
<!--            <GeneratedDtoFiles Include="$(CompilerGeneratedFilesOutputPath)\**\*.g.cs"/>-->
<!--        </ItemGroup>-->
<!--        <MakeDir Directories="$(ProjectDir)GeneratedDtos" Condition="'@(GeneratedDtoFiles)' != ''"/>-->
<!--        <Copy SourceFiles="@(GeneratedDtoFiles)" DestinationFiles="$(ProjectDir)GeneratedDtos\%(Filename)%(Extension)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'@(GeneratedDtoFiles)' != ''"/>-->
<!--        <Message Text="Copied %(Filename)%(Extension) to $(ProjectDir)GeneratedDtos" Importance="high" Condition="'@(GeneratedDtoFiles)' != ''"/>-->
<!--    </Target>-->

    <!-- Exclude generated DTOs from compilation, but keep them visible in Solution Explorer -->
<!--    <ItemGroup>-->
<!--        <Compile Remove="GeneratedDtos\**\*.cs"/>-->
<!--        <None Include="GeneratedDtos\**\*.cs"/>-->
<!--    </ItemGroup>-->

    <ItemGroup>
        <PackageReference Include="DKNet.EfCore.DtoGenerator">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="DKNet.EfCore.Specifications" />
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="ForEvolve.FluentValidation.AspNetCore.Http"/>
        <PackageReference Include="Mapster.DependencyInjection"/>
        <PackageReference Include="SlimMessageBus"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <PackageReference Include="Scrutor"/>
        <PackageReference Include="DKNet.SlimBus.Extensions"/>
        <PackageReference Update="Meziantou.Analyzer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Minimal.Domains\Minimal.Domains.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Minimal.App.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Features\Profiles\V1\Actions\DeleteProfileCommand.cs">
            <DependentUpon>Delete.cs</DependentUpon>
        </Compile>
        <Compile Update="Features\Profiles\V1\Actions\UpdateProfileCommand.cs">
            <DependentUpon>Update.cs</DependentUpon>
        </Compile>
        <Compile Update="Features\Profiles\V1\Actions\CreateProfileCommand.cs">
            <DependentUpon>Create.cs</DependentUpon>
        </Compile>
        <Compile Update="Features\Profiles\V1\Events\ProfileCreatedEvent.cs">
            <DependentUpon>ProfileCreatedEventHandlers.cs</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="CustomerProfiles\V1\Queries\" />
    </ItemGroup>
</Project>