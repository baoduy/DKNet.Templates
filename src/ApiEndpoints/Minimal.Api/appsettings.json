{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "AzureMonitor": {
    "ConnectionString": ""
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "OTEL_SERVICE_NAME": "Minimal.Api",
  "Authentication": {
    "DefaultScheme": "Bearer",
    "Schemes": {
      "Bearer": {
        "MetadataAddress": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0/.well-known/openid-configuration",
        "ValidAudiences": [
          "api://your-api"
        ],
        "ValidIssuer": "https://sts.windows.net/00000000-0000-0000-0000-000000000000/"
      }
    }
  },
  "FeatureManagement": {
    "EnableHttps": true,
    "EnableSwagger": false,
    "EnableAntiforgery": false,
    "EnableServiceBus": true,
    "RequireAuthorization": true,
    "RunDbMigrationWhenAppStart": false,
    "EnableRateLimit": true,
    "EnableAzureAppConfig": false,
    "EnableVersioning": true,
    "EnableOpenTelemetry": false
  },
  "RateLimit": {
    "DefaultRequestLimit": 100,
    "DefaultConcurrentLimit": 20,
    "TimeWindowInSeconds": 1
  },
  "ConnectionStrings": {
    "TEMPDb": "",
    "AppConfig": "",
    "AzureAppConfiguration": ""
  },
  "AzureAppConfiguration": {
    "KeyPrefix": "",
    "Label": "",
    "CacheExpirationInSeconds": 300,
    "LoadFeatureFlags": true,
    "FeatureFlagPrefix": ""
  }
}