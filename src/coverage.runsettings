<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <!-- MaxCpuCount=1 (R4, DRK-1271): the root CI solution now runs Minimal.App.Tests and
         DKNet.Templates.ScaffoldTests together, and both fixtures mutate the machine-global
         `dotnet new` template store for the same identity (DKNet.Minimal.Template) — they must
         never execute concurrently. -->
    <RunConfiguration>
        <MaxCpuCount>1</MaxCpuCount>
    </RunConfiguration>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <Include>
                        [DKNet*]*,
                        [Minimal*]*
                    </Include>
                    <Exclude>
                        [*.Tests]*,
                        [*Tests]*,
                        [*.TestObjects]*,
                        [*TestDataLayer]*
                    </Exclude>
                    <ExcludeByFile>
                        **/bin/**,
                        **/obj/**,
                        **/*Tests.cs,
                        **/*Test.cs,
                        **/TestObjects/**,
                        **/GlobalUsings.cs,
                        **/*.g.cs
                    </ExcludeByFile>
                    <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
