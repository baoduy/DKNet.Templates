  "cards": [
    {
      "dot": "cyan",
      "title": "Only two transitions",
      "items": [
        "Approve, price changes and supplier-reference assignment update fields but never move the product off 'For sale'",
        "Discontinuing also creates a separate, independent replacement Product in the same transaction — that new row starts its own lifecycle at 'For sale'"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusals are not transitions",
      "items": [
        "DELETE while still for sale answers 409 and leaves the product on 'For sale'",
        "A second PUT /{id}/discontinue on an already-discontinued product answers 400 and leaves it on 'Discontinued' — discontinuing is not idempotent"
      ]
    }
  ]
