  "cards": [
    { "dot": "emerald", "title": "Idempotent create", "items": ["The create route is the only one in the sample calling RequiredIdempotentKey()", "A new key runs the full pipeline: FluentValidation, construct the aggregate, persist, then cache the response", "PurchaseOrder's constructor calls AddEvent(PurchaseOrderCreatedEvent) before SaveChanges; EventPublisher publishes it only after the row commits"] },
    { "dot": "rose", "title": "Replay refusal", "items": ["This deployment sets ConflictHandling = ConflictResponse, so a replayed key answers 409 Conflict, not the cached 201 body", "The handler never runs on a replay — the filter answers before the pipeline starts", "A missing X-Idempotency-Key header is refused earlier still, with 400, before the filter checks the store"] },
    { "dot": "slate", "title": "What this diagram cannot show", "items": ["The transaction boundary: the aggregate construction, AddAsync and SaveChanges run inside one DbContext save, not three steps", "What happens if the in-memory bus publish throws after the row already committed — untested by this sample", "The 400 (validation), 404 (unknown id) and 409 (already cancelled) refusals on the other routes, covered in Endpoints"] }
