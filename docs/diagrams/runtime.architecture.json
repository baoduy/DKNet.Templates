  "cards": [
    {
      "dot": "cyan",
      "title": "Edge pipeline",
      "items": [
        "Forwarded headers, security headers, CORS, HTTPS, /healthz",
        "Request bounds, rate limiter, then authentication",
        "Validation runs as a route-group filter"
      ]
    },
    {
      "dot": "rose",
      "title": "Auth switch",
      "items": [
        "FeatureManagement:RequireAuthorization on: JWT bearer against your OIDC tenant",
        "Off, with EnableDemoAuthentication on (Development): built-in demo identity, no token needed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stores",
      "items": [
        "ConnectionStrings:AppDb is required: with RunDbMigrationWhenAppStart on, start-up migration throws without it",
        "ConnectionStrings:Redis unset: in-process cache and idempotency store, single instance only"
      ]
    },
    {
      "dot": "amber",
      "title": "Events",
      "items": [
        "Domain events leave CoreDbContext through EventPublisher onto IMessageBus",
        "Forwarded to Azure Service Bus only with EnableServiceBus and ConnectionStrings:AzureBus"
      ]
    }
  ]
