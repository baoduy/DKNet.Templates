  "cards": [
    {
      "dot": "cyan",
      "title": "What the generators emit",
      "items": [
        "CreateProductRequest, ChangePriceProductRequest, ApproveProductRequest, DiscontinueProductRequest",
        "A handler per request, in the Minimal.AppServices.Crud namespace",
        "MapGetById, MapGetList, MapDeleteById, MapPost, MapPutById and one MapActionById per action",
        "Output lands under obj/Generated/, never in source control"
      ]
    },
    {
      "dot": "amber",
      "title": "What stays hand-written",
      "items": [
        "The IEntityTypeConfiguration mapping and any seed data",
        "Every event consumer \u2014 RaisesEvent only declares and raises",
        "Idempotency: no generated route calls RequiredIdempotentKey()",
        "Enforced validation: forwarded DataAnnotations are never evaluated on a generated route"
      ]
    }
  ]
