{
    "id": "feature-documentation",
    "version": "1.0.0",
    "title": "Feature Documentation with Diagrams",
    "category": "Documentation & Knowledge Management",
    "difficulty": "Beginner",
    "estimatedDurationMinutes": {
        "min": 30,
        "max": 60
    },
    "prerequisites": [
        "Completed Domain Modeling skill (Skill 1)",
        "Completed CRUD Operations skill (Skill 2)",
        "Completed API Endpoints skill (Skill 3)",
        "Feature implementation is done (or substantially done)"
    ],
    "inputs": {
        "description": "Completed feature implementation details (entities, endpoints, events, validators)",
        "items": [
            "Feature/entity name",
            "List of API endpoints (HTTP method + route + description)",
            "Entity properties and relationships",
            "Domain events published/consumed",
            "Business rules and validation constraints",
            "Any state machine (statuses/transitions)"
        ]
    },
    "outputs": {
        "description": "Complete feature documentation under docs/features/<feature-name>/",
        "items": [
            "docs/features/<feature-name>/README.md — Overview, purpose, usage guide",
            "docs/features/<feature-name>/architecture.md — Vertical slice diagram, component responsibilities",
            "docs/features/<feature-name>/api-reference.md — All endpoints, request/response examples",
            "docs/features/<feature-name>/data-model.md — Entity diagram, properties, constraints",
            "docs/features/<feature-name>/events.md — Domain events catalog with subscriber list"
        ]
    },
    "outputs_saved_to": "docs/features/<feature-name>/",
    "related_skills": [
        "domain-modeling",
        "crud-operations",
        "api-endpoints"
    ],
    "tags": [
        "documentation",
        "diagrams",
        "mermaid",
        "c4-model",
        "api-reference",
        "architecture",
        "knowledge-sharing"
    ],
    "diagram_tools": [
        "Mermaid.js (GitHub-native, VS Code, Obsidian)",
        "C4 PlantUML (optional, for deployment/context diagrams)"
    ]
}