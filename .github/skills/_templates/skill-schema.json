{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GitHub Copilot Skill Metadata Schema",
    "description": "Validates metadata.json for all reusable AI skills in DKNet.Templates",
    "type": "object",
    "required": [
        "id",
        "title",
        "category",
        "difficulty",
        "estimatedDurationMinutes",
        "prerequisites",
        "inputs",
        "outputs",
        "successCriteria",
        "nonGoals",
        "folderPath"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 3,
            "maxLength": 50,
            "description": "Unique identifier in kebab-case (lowercase, hyphens only); must match folder name"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version (e.g., 1.0.0); defaults to 1.0.0 if omitted",
            "default": "1.0.0"
        },
        "title": {
            "type": "string",
            "minLength": 10,
            "maxLength": 80,
            "description": "Human-readable skill name; keep under 80 characters for UI display"
        },
        "category": {
            "type": "string",
            "enum": [
                "Persistence & Entities",
                "Business Logic & Commands",
                "REST API & Orchestration"
            ],
            "description": "Strict category for organizing and filtering skills in catalog"
        },
        "difficulty": {
            "type": "string",
            "enum": [
                "Beginner",
                "Intermediate",
                "Advanced"
            ],
            "description": "Skill difficulty level for setting developer expectations"
        },
        "estimatedDurationMinutes": {
            "type": "object",
            "required": [
                "min",
                "max"
            ],
            "additionalProperties": false,
            "properties": {
                "min": {
                    "type": "integer",
                    "minimum": 5,
                    "description": "Minimum time estimate in minutes"
                },
                "max": {
                    "type": "integer",
                    "description": "Maximum time estimate in minutes"
                }
            },
            "description": "Time estimates for skill completion"
        },
        "prerequisites": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 100
            },
            "description": "List of required knowledge/tools before starting (no tribal knowledge)"
        },
        "inputs": {
            "type": "object",
            "required": [
                "description",
                "items"
            ],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 200,
                    "description": "Brief description of what inputs are needed"
                },
                "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 100
                    },
                    "description": "List of specific inputs (e.g., entity name, properties, relationships)"
                }
            },
            "description": "Information developer must gather before starting skill"
        },
        "outputs": {
            "type": "object",
            "required": [
                "description",
                "items"
            ],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 200,
                    "description": "Brief description of deliverables"
                },
                "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 100
                    },
                    "description": "List of specific deliverables (e.g., classes, files, migrations)"
                }
            },
            "description": "What developer will have created upon completion"
        },
        "successCriteria": {
            "type": "array",
            "minItems": 3,
            "maxItems": 20,
            "items": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200
            },
            "description": "Testable acceptance criteria; maps to checklist.md items"
        },
        "nonGoals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 150
            },
            "description": "Explicitly out-of-scope items to prevent scope creep"
        },
        "relatedSkills": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
            },
            "description": "IDs of related skills in suggested workflow order"
        },
        "folderPath": {
            "type": "string",
            "pattern": "^\\.github/skills/[a-z0-9-]+$",
            "description": "Relative path to skill folder from repository root"
        },
        "examplesPath": {
            "type": "string",
            "pattern": "^\\.github/skills/[a-z0-9-]+/examples/",
            "description": "Optional: Relative path to examples folder if included"
        },
        "testPath": {
            "type": "string",
            "description": "Optional: Relative path to test file if included"
        },
        "status": {
            "type": "string",
            "enum": [
                "draft",
                "published",
                "deprecated",
                "removed"
            ],
            "default": "published",
            "description": "Skill lifecycle status"
        },
        "createdDate": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date skill was created (YYYY-MM-DD)"
        },
        "lastUpdatedDate": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date skill was last updated (YYYY-MM-DD)"
        }
    }
}