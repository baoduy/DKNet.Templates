{
  "inputs": [
    {
      "type": "promptString",
      "id": "falkordb-password",
      "description": "FalkorDB password for the local codegraph instance",
      "password": true
    }
  ],
  "servers": {
    "falkordb-codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@falkordb/mcpserver@latest"
      ],
      "env": {
        "FALKORDB_HOST": "localhost",
        "FALKORDB_PORT": "6379",
        "FALKORDB_USERNAME": "",
        "FALKORDB_PASSWORD": "${input:falkordb-password}"
      }
    },
    "qdrant-docsearch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "Minimal-docs",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      }
    }
  }
}
